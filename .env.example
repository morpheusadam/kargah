APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Exchange rates — fetched once a day by accounting:fetch-rates, never during a request.
# TCMB EVDS is the official Turkish rate and the one a domestic invoice must use by law.
# It is free but needs an account: register at https://evds2.tcmb.gov.tr and take the key
# from Profil > API Anahtarı. Leave it empty and the other two sources still run.
EVDS_API_KEY=
# Optional. Raises CoinGecko's per-minute limit; the keyless endpoint works fine for one
# call a day. https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
# Frankfurter is self-hostable — point this at your own instance to drop the dependency.
FRANKFURTER_URL=https://api.frankfurter.dev/v1

# GitHub — read once a day by data:sync-repos, never during a request. A classic or
# fine-grained personal access token with `repo` scope is enough; the command only reads.
# Create one at https://github.com/settings/tokens. Leave it empty and the command says so
# and exits cleanly, so the scheduler entry stays harmless on a machine with no token.
GITHUB_TOKEN=

# Mail received by being handed it, rather than by going to fetch it.
#
# A Cloudflare Email Worker posts each incoming message to POST /mail/inbound, and this is
# the shared secret it sends in `X-Inbound-Secret`. It must equal the Worker's own
# `INBOUND_SECRET` — see mail-worker/wrangler.toml.
#
# 🔴 Empty disables the endpoint outright rather than leaving it open: an install with no
# secret has no Worker either, and a route that accepted anything would let a stranger write
# rows into somebody's inbox. A wrong secret answers 404, deliberately — an endpoint that
# said "wrong secret" would be confirming it exists and is worth grinding at. So "the Worker
# is posting and nothing arrives" is what a mismatch looks like, not an error anywhere.
#
# Not the application key and not shared with anything else. It is handed to a third party.
MAILBOX_INBOUND_SECRET=

# What comes back from a campaign after it has been read. Both default to on; off means the
# message is not changed at all — no pixel, no rewritten link — rather than merely not
# recorded. See Modules/Mailbox/config/config.php for what each one actually does to a body.
# MAILBOX_TRACK_OPENS=true
# MAILBOX_TRACK_CLICKS=true

# The rest of Mailbox's knobs exist because the target is shared hosting, where a request
# gets about thirty seconds. Every default is documented where it is read, and none of them
# needs setting on an ordinary install:
#   MAILBOX_SYNC_CHUNK_SIZE, MAILBOX_SYNC_CHUNKS_PER_TICK, MAILBOX_SYNC_ACCOUNTS_PER_TICK,
#   MAILBOX_IMAP_TIMEOUT, MAILBOX_INBOUND_MAX_SIZE_KB, MAILBOX_INBOUND_FOLDER,
#   MAILBOX_SEND_CHUNK_SIZE, MAILBOX_SEND_CHUNKS_PER_TICK, MAILBOX_SEND_CAMPAIGNS_PER_TICK,
#   MAILBOX_STALE_CLAIM_MINUTES, MAILBOX_SOFT_BOUNCE_THRESHOLD
